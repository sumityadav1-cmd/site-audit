# Copy to .env on the server and fill in. Never commit the filled-in file.
# Load it with: set -a; . ./.env; set +a

# --- Network -----------------------------------------------------------------
PORT=3001
# Default 127.0.0.1. Set 0.0.0.0 to accept connections from other machines —
# only do this with AUTH_USER/AUTH_PASSWORD set.
HOST=0.0.0.0

# --- Access control ----------------------------------------------------------
# Both must be set to turn auth on. Required whenever HOST is not loopback:
# anyone who can reach this port can make the server fetch any URL they name,
# from its IP and inside its network.
AUTH_USER=
AUTH_PASSWORD=

# --- Storage -----------------------------------------------------------------
# Absolute path recommended in production so it does not depend on the cwd.
DATABASE_PATH=/var/lib/site-audit/site-audit.db

# --- Crawling ----------------------------------------------------------------
MAX_RUNNING_AUDITS=2

# Allowlist for internal crawl targets. Exact hostnames and IPv4 CIDRs, comma
# separated. Everything not listed stays blocked, and cloud metadata endpoints
# (169.254.169.254 etc.) can never be allowlisted. Leave empty for public sites
# only.
#   ALLOW_PRIVATE_HOSTS=intranet.example.com,10.20.0.0/16
ALLOW_PRIVATE_HOSTS=

# --- Lighthouse (optional) ---------------------------------------------------
# Base64 of "login:password" from the DataForSEO dashboard. Without this the
# Performance tab is hidden. Billed per check, up to 20 checks per audit.
DATAFORSEO_API_KEY=
# Alternative to the key above:
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
